# Composer dependencies
/vendor
/server/vendor

# Node dependencies
/node_modules

# Laravel environment files
.env
.env.*
.env.backup

# Laravel storage (runtime data — кэш, сессии, логи)
storage/*
!storage/.gitignore
!storage/app
!storage/app/public
!storage/framework
!storage/framework/cache
!storage/framework/sessions
!storage/framework/testing
!storage/framework/views
!storage/logs
!storage/logs/.gitignore

# Laravel bootstrap cache
bootstrap/cache/*
!bootstrap/cache/.gitignore

# Laravel test output
.phpunit.result.cache

# Laravel IDE helper
.phpstorm.meta.php
_ide_helper.php
_ide_helper_models.php

# Laravel misc
.php-cs-fixer.cache

# Log & debug
*.log

# OS/filesystem junk
.DS_Store
Thumbs.db

# Editor junk
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# 🔥 Игнорировать содержимое server/logs — но оставить папку
/server/logs/*
!server/logs/.gitignore
